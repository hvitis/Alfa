    "render:assets": "node web/render-assets.mjs",
    "export:pdf": "node web/export-pdf.mjs",
    "export:plywood-pdf": "node web/export-plywood-guide.mjs"
  },
  "devDependencies": {
    "markdown-it": "14.3.3",
    "mermaid": "11.12.2",
    "playwright": "1.64.0",
    "three": "0.186.1",
    "vite": "8.3.2"
  }
}
