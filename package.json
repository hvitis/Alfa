{
  "name": "alfa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:syntax": "node web/tests/check-syntax.mjs && node --test web/tests/device-sim.test.js web/tests/routes.test.js",
    "test:smoke": "node web/tests/smoke-tests.mjs",
    "test:viewer": "node --test web/hardware-visualisation/tests/*.test.js",
